{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./base.json",
  "compilerOptions": {
    // Language and Environment
    "lib": ["ESNext"],

    // Modules
    "module": "NodeNext",

    // Emit
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
